# Copy to .env.local and fill in. Everything here is public (it ships in the bundle) —
# the private VAPID key and the service-role key are Supabase function secrets, never
# VITE_ variables.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Generate once:  npx web-push generate-vapid-keys
# The PUBLIC half goes here. The PRIVATE half goes to Supabase function secrets:
#   supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=
